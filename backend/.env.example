# Backend-only signer path; never commit the keypair file or its contents.
# Relative paths are resolved from the project directory (vietnam-history-gamefi/) first,
# then from backend/, so uvicorn/pytest can be started from any working directory.
# Absolute paths are used as-is (Render Secret File, e.g. /etc/secrets/reward-distributor.json).
# Create the Devnet signer once; its public key must equal REWARD_DISTRIBUTOR_AUTHORITY:
#   mkdir -p backend/keys
#   solana-keygen new --outfile backend/keys/reward-distributor.json
#   solana airdrop 2 <PUBKEY> --url devnet
# Verify before starting the API (run from backend/; prints the problem or "reward signer ready"):
#   python -c "from app.core.config import get_settings; from app.core.reward_signer import validate_reward_distributor_signer as v; print(v(get_settings()) or 'reward signer ready')"
REWARD_DISTRIBUTOR_KEYPAIR_PATH=backend/keys/reward-distributor.json
# Fallback when no Secret File is mounted (Render env var). JSON array of 64 ints 0-255.
# Never log or commit this value.
# REWARD_DISTRIBUTOR_KEYPAIR_JSON=
